# Puerto donde escucha el servidor HTTP
PORT=8080

# Entorno de ejecución: development | production | test
# En production la cookie de sesión se marca secure (solo viaja por HTTPS).
NODE_ENV=development

# Cadena de conexión a MongoDB (Atlas o local). Obligatoria: el servidor no arranca sin ella.
# Formato Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/cafe_aurora_eventos?appName=Cluster
# Formato local: mongodb://127.0.0.1:27017/cafe_aurora_eventos
MONGO_URL=mongodb://127.0.0.1:27017/cafe_aurora_eventos

# Secreto para firmar y verificar los JSON Web Tokens. Obligatorio.
# Usa un valor largo y aleatorio, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# Expiración del JWT: número de segundos (3600) o duración con unidad (15m, 1h, 7d). Por defecto 1h.
# La cookie de sesión dura 1 hora; la sesión efectiva termina con lo que expire primero.
JWT_EXPIRES_IN=1h

# Costo del hash de bcrypt (rondas de salt, entre 10 y 14). Opcional; por defecto 10.
BCRYPT_SALT_ROUNDS=10

# Correo de confirmación de inscripciones (Nodemailer). Las credenciales nunca van en el código.
# Sin MAIL_HOST el servidor arranca igual y registra los correos en consola en vez de enviarlos.
# Para probar sin una cuenta real: https://ethereal.email (crea una cuenta de prueba con host, usuario
# y clave) o Mailtrap. Con Gmail usa una "contraseña de aplicación" en MAIL_PASS, no la clave normal.
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=usuario_de_prueba@ethereal.email
MAIL_PASS=clave_de_prueba
MAIL_FROM="Café Aurora <no-reply@cafeaurora.cl>"
